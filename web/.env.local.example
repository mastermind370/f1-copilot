# Copy to .env.local. URL of the local API started with `copilot serve`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: anonymous, cookieless page counts with Plausible. Set to your site's domain
# (for example f1-copilot.vercel.app). Leave unset to load no analytics at all.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
